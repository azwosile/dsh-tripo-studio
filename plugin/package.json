{
  "name": "dsh-tripo-studio",
  "version": "0.3.3",
  "private": true,
  "description": "Local-first GPT-image 2.5 to Tripo 3D workflow for DSH Desktop",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client-v0.3.3.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client-v0.3.3.js",
    "server",
    "shared",
    "client-src",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "tests",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "package-lock.json"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "tripo",
    "3d",
    "workbench"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/smoke-test.mjs",
    "test:host": "node scripts/test-host.mjs",
    "install:local": "node scripts/install-local.mjs --dry-run",
    "test:compat": "node scripts/test-appearance.mjs",
    "test:credentials": "node scripts/test-credentials.mjs",
    "test:host:routes": "node scripts/test-host-routes.mjs",
    "test:v029": "node scripts/test-v029.mjs",
    "test:v0210": "node scripts/test-v0210.mjs",
    "test:v0211": "node scripts/test-v0211.mjs",
    "test:v0212": "node scripts/test-v0212.mjs",
    "test:v030": "node scripts/test-v030.mjs",
    "test:v031": "node scripts/test-v031.mjs",
    "test:v032": "node scripts/test-v032.mjs",
    "test:v033": "node scripts/test-v033.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "directories": {
    "lib": "lib"
  },
  "author": "",
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@playwright/test": "1.58.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.180.0",
    "esbuild": "0.25.12"
  }
}